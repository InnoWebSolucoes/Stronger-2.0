{
  "expo": {
    "name": "Stronger",
    "slug": "stronger-2-0",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stronger",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07090F",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.innoweb.stronger",
      "backgroundColor": "#07090F",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.innoweb.stronger",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#07090F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#07090F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Stronger uses the camera only when you choose to take a progress photo. Photos stay on this device unless you turn on encrypted backup."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stronger asks for photo access only when you import an existing progress photo."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Stronger uses Face ID to lock your progress photos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5A524",
          "defaultChannel": "rest-timer"
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    }
  }
}
